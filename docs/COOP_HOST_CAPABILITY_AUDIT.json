  "findings": [
    {
      "id": "H1",
      "status": "IMPLEMENTED_SOURCE_ONLY",
      "claim": "Fixed developer-selected ENHANCED/REFERENCE source-contract identity; full256-bit mutual content agreement gates frame admission.",
      "evidence": [
        "sdk:cmake/psx_execution_profile.cmake",
        "sdk:runtime/include/execution_identity.h",
        "sdk:runtime/include/netplay_content_gate.h",
        "sdk:runtime/src/psx_netplay.c"
      ]
    },
    {
      "id": "H2",
      "status": "GAP",
      "claim": "Inspected PSX setup has no actual CPU architecture/optional-feature offers, available backend sets, qualified simulation profile offers, deterministic common-profile selection or portable fallback agreement.",
      "evidence": [
        "sdk:runtime/include/psx_lobby_client.h",
        "sdk:runtime/src/psx_lobby_client.c",
        "net:include/recomp_net/config.h",
        "net:src/protocol/rnet_protocol.c",
        "net:src/session/rnet_session.c"
      ]
    },
    {
      "id": "H3",
      "status": "IMPLEMENTED_SOURCE_ONLY",
      "claim": "X6v10 composes title/config/loading and retained-texture policy into identity; modern X6 requires locally working OpenGL retained textures and fails startup when unsupported.",
      "evidence": [
        "game:src/mods/mmx6_coop_plugin.c",
        "sdk:runtime/src/mod_netplay.c",
        "sdk:runtime/src/main.cpp"
      ]
    },
    {
      "id": "H4",
      "status": "IDENTITY_LIMIT",
      "claim": "Forced v10 profile replaces lobby game_version; source-contract digest is not whole-binary/compiler/options/hardware identity and does not automatically hash executable-owned coop plugin bytes.",
      "evidence": [
        "sdk:runtime/src/psx_lobby_client.c",
        "sdk:runtime/src/mod_runtime.cpp",
        "sdk:cmake/psx_execution_profile.cmake",
        "sdk:runtime/runtime.cmake",
        "game:CMakeLists.txt"
      ]
    },
    {
      "id": "H5",
      "status": "EXTENSION_POINT_ONLY",
      "claim": "Generic net lobby codec/ext and session_variant exist but do not implement PSX CPU/backend/profile negotiation; PSX still has separate concrete caps serializer.",
      "evidence": [
        "net:include/recomp_net/lobby_client.h",
        "net:docs/lobby.md",
        "sdk:runtime/include/psx_lobby_client.h",
        "sdk:runtime/src/psx_lobby_client.c"
      ]
    },
    {
      "id": "H6",
      "status": "EXAMPLE_SOURCE_ONLY",
      "claim": "MDEC retains scalar and gated SSE2 implementation with local self-checks; this is not heterogeneous OS/CPU replay qualification or a capability exchange.",
